{
  "name": "glacify",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire as __glacifyRequire } from 'module';const require = __glacifyRequire(import.meta.url);\"",
    "start": "node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
