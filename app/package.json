    "motion": "^12.43.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
