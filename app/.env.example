# Copier en .env et adapter les valeurs
NODE_ENV=production
APP_URL=https://glacify.bastiengaffet.fr
HOST=127.0.0.1
# Port libre sur le VPS (Equiliz 8099, Babelibris 8102) : à vérifier avant la mise en ligne
PORT=8103
# Clé de signature des sessions : générer avec `openssl rand -hex 32`
APP_SECRET=change-me-with-openssl-rand-hex-32
DATABASE_URL=mysql://glacify:mot-de-passe@127.0.0.1:3306/glacify
# Inscriptions ouvertes (false = seuls les comptes existants peuvent se connecter)
REGISTRATION_OPEN=true
# Bêta gratuite : tout est gratuit et illimité pour tout le monde (valeur par défaut).
# Seul BETA_PREMIUM=false remettrait les limites de contracts/plans.ts.
BETA_PREMIUM=true
